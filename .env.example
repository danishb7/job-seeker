OPENAI_API_KEY=sk-your-key-here

# Default model when the UI does not override (must appear in OPENAI_MODEL_OPTIONS).
OPENAI_MODEL=gpt-5.5

# Exactly three comma-separated model IDs for the toolbar + API whitelist.
OPENAI_MODEL_OPTIONS=gpt-5.5,gpt-5.5-mini,gpt-4o

# Optional: three display labels for the toolbar (Quality / Balanced / Economy).
# OPENAI_MODEL_LABELS=Quality,Balanced,Economy

# Optional: reduce TPM / 429 errors — web_search context (low | medium | high)
# OPENAI_SEARCH_CONTEXT_SIZE=low

# Cap model output + reasoning budget; default 4096 (enough for ~10 compact rows).
# OPENAI_MAX_OUTPUT_TOKENS=4096

# Hard cap on web_search tool calls per run (prompt + API). Default 2.
# OPENAI_MAX_WEB_SEARCH_CALLS=2

# Max length for each job's "why_match" (prompt + truncation). Default 100.
# WHY_MATCH_MAX_CHARS=100

# gpt-5 / o-series only: none | minimal | low | medium | high | xhigh — saves reasoning tokens.
# OPENAI_REASONING_EFFORT=minimal

# Set to false to disable Responses API json_schema text format (fallback parsing only).
# OPENAI_RESPONSE_JSON_SCHEMA=true
